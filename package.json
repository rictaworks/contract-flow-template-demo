{
  "private": true,
  "name": "contract-flow-template-demo",
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n worker,frontend \"npm:dev:worker\" \"npm:dev:frontend\"",
    "dev:worker": "wrangler dev --local --port 8787",
    "dev:frontend": "vite",
    "build": "npm run build:frontend",
    "build:frontend": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.frontend.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply contract_flow_demo --local"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "@playwright/test": "^1.47.2",
    "@types/node": "^22.20.2",
    "concurrently": "^9.0.1",
    "typescript": "^5.6.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "wrangler": "^3.78.10"
  },
  "dependencies": {
    "hono": "^4.6.3"
  }
}
